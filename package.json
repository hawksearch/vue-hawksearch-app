{
  "name": "vue-hawksearch-app",
  "version": "1.0.0",
  "description": "Hawksearch Vue app bundler",
  "private": true,
  "author": "Hawksearch",
  "scripts": {
    "build": "webpack --mode production --devtool source-map",
    "dev": "webpack --watch --mode development",
    "prepare": "npm run build --prefix node_modules/@hawksearch/vue"
  },
  "module": "dist/js/vue-hawksearch-app.js",
  "dependencies": {
    "@babel/core": "^7.12.16",
    "@babel/plugin-proposal-class-properties": "^7.8.3",
    "@babel/plugin-proposal-export-default-from": "^7.8.3",
    "@babel/plugin-proposal-object-rest-spread": "^7.5.5",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.9.6",
    "@babel/preset-env": "^7.9.5",
    "@hawksearch/vue": "github:hawksearch/vue-hawksearch#vue-2.7",
    "babel-loader": "^8.0.6",
    "core-js": "^3.8.3",
    "css-loader": "^2.1.1",
    "mini-css-extract-plugin": "^0.9.0",
    "sass": "^1.97.3",
    "sass-loader": "^8.0.2",
    "vue": "^2.7.16",
    "vue-loader": "^15.10.0",
    "vue-template-compiler": "^2.7.16",
    "vuex": "^3.1.3",
    "webpack": "^4.43.0",
    "webpack-cli": "^3.3.11"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.12.16",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "IE 11"
  ],
  "license": "Apache-2.0",
  "main": "app.js",
  "keywords": []
}
